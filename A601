local function Jumpscare()
	local Players = game:GetService("Players")
	local TweenService = game:GetService("TweenService")

	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")
	local rng = Random.new()

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "JumpscareGui"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.DisplayOrder = 999999
	screenGui.Parent = playerGui

	-- Tạo background
	local background = Instance.new("Frame")
	background.Name = "Background"
	background.Size = UDim2.fromScale(1, 1)
	background.Position = UDim2.fromScale(0, 0)
	background.BackgroundColor3 = Color3.new(0, 0, 0)
	background.BorderSizePixel = 0
	background.Parent = screenGui

	-- Tạo ImageLabel
	local imageLabel = Instance.new("ImageLabel")
	imageLabel.Name = "ImageLabel"
	imageLabel.BackgroundTransparency = 1
	imageLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	imageLabel.Position = UDim2.fromScale(0.5, 0.5)
	imageLabel.Size = UDim2.new(0, 0.001, 0, 0.001)
	imageLabel.Image = "rbxassetid://4817426006"
	imageLabel.Parent = background

	-- Tạo Sound
	local jumpscareSound = Instance.new("Sound")
	jumpscareSound.Name = "Jumpscare"
	jumpscareSound.SoundId = "rbxassetid://25954372"
	jumpscareSound.Volume = 5
	jumpscareSound.PlaybackSpeed = 1.95
	jumpscareSound.Parent = workspace


	jumpscareSound:Play()

	local dis = Instance.new("DistortionSoundEffect")
	dis.Level = 1
	dis.Enabled = true
	dis.Parent = jumpscareSound
	
	local eq = Instance.new("EqualizerSoundEffect")
	eq.HighGain = 1.9
	eq.MidGain = -24.2
	eq.LowGain = 10
	eq.Enabled = true
	eq.Parent = jumpscareSound

	local fullTween = TweenService:Create(
		imageLabel,
		TweenInfo.new(0.8, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
		{
			Size = UDim2.new(0, 1550, 0, 1550)
		}
	)
	
	local chanceid = {
		"8960526619",
		"6196108971",
		"6734172334",
		"7057923071",
		"4817426006"
	}

	task.spawn(function()
		while true do
			local randomId = chanceid[math.random(1, #chanceid)]
			imageLabel.Image = "rbxassetid://" .. randomId
			task.wait(0.03)
		end
	end)

	fullTween:Play()

	for i = 1, 80 do
		local mode = rng:NextInteger(1, 3)

		if mode == 1 then
			background.BackgroundColor3 = Color3.new(0, 0, 0)
			imageLabel.ImageColor3 = Color3.new(1, 0, 1)
		elseif mode == 2 then
			background.BackgroundColor3 = Color3.new(1, 0, 1)
			imageLabel.ImageColor3 = Color3.new(0, 0, 0)
		else
			background.BackgroundColor3 = Color3.new(0.666667, 0, 1)
			imageLabel.ImageColor3 = Color3.new(1, 0, 1)
		end
		
		imageLabel.Position = UDim2.new(rng:NextNumber(0.4, 0.6), 0, rng:NextNumber(0.4, 0.6), 0)
		imageLabel.Rotation = rng:NextInteger(-10, 10)
		task.wait(0.00001)
	end


	screenGui:Destroy()
	imageLabel:Destroy()
	background:Destroy()
end

entity:SetCallback("OnEnterRoom", function(room: Model, firstTime: boolean)
	if firstTime == true then
		print("Entity has entered room: ".. room.Name.. " for the first time")
		local entity5 = entity.Model
		if not entity5 or not firstTime then return end

		task.spawn(function()
			task.wait(0.1)
			local wardrobes = {}

			for _, v in ipairs(room:GetDescendants()) do
				if v:IsA("Model") then
					local n = string.lower(v.Name)
					if n:find("wardrobe") or n:find("closet") then
						table.insert(wardrobes, v)
					end
				end
			end

			table.sort(wardrobes, function(a, b)
				return a:GetPivot().Position.X < b:GetPivot().Position.X
			end)

			local player = game.Players.LocalPlayer
			local char = player.Character

			for _, wardrobe in ipairs(wardrobes) do
				entity:Pause()
				entity5:PivotTo(wardrobe:GetPivot() * CFrame.new(0, 0, -7))
				task.wait(0.35)

				local function isPlayerInsideWardrobe()
					if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
					local boxPos = wardrobe:GetPivot().Position
					return (char.HumanoidRootPart.Position - boxPos).Magnitude < 6
				end

				local wasHiding = isPlayerInsideWardrobe()
				task.wait(1.5)

				-- Destroy Doors + Prompts
				for _, v in ipairs(wardrobe:GetDescendants()) do
					if v:IsA("ProximityPrompt") or v.Name == "HidePrompt" then v:Destroy()
					end
				end

				-- KILL + JUMPSCARE
				if isPlayerInsideWardrobe() or wasHiding then
					if char then
						task.spawn(Jumpscare) 
						task.wait(0.1)
						local hum = char:FindFirstChildOfClass("Humanoid")
						if hum then hum.Health = 0 end
					end
				end

				entity:Resume()
				task.wait(0.2)
			end
		end)
	else
		print("Entity has entered room: ".. room.Name.. " again")
	end
end)

